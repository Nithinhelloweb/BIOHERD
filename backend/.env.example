# ==============================================================================
# BIOHERD — Backend Environment Variables Template
# On Render: Configure these in Service Settings -> Environment Variables
# ==============================================================================

# Core Application Settings
PROJECT_NAME="BIOHERD"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
PORT=8000

# Security (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY="generate-a-secure-random-key-here-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database
# 1. Zero-Setup SQLite (default):
DATABASE_URL="sqlite+aiosqlite:///./bioherd_prod.db"
# 2. Render Managed PostgreSQL or Neon / Supabase (Note: Render's postgres:// is auto-converted):
# DATABASE_URL="postgresql+asyncpg://bioherd_user:yourpassword@dpg-xxx.oregon-postgres.render.com/bioherd_db"

# Cache & Rate Limiting: Redis 7
# (If not provided or unreachable, BIOHERD gracefully falls back to resilient in-memory cache)
# REDIS_URL="redis://localhost:6379/0"

# Object Storage: MinIO / AWS S3
# (If not provided or unreachable, BIOHERD gracefully falls back to resilient memory storage)
# MINIO_ENDPOINT="localhost:9000"
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin"
# MINIO_SECURE=false
# MINIO_BUCKET_NAME="bioherd-assets"

# CORS Whitelist (Flutter Web & Admin Dashboards)
# Set to "*" to allow all origins, or comma-separated origins
CORS_ORIGINS="*"
